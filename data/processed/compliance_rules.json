    "R1": {
        "section": "Rules",
        "question": "Does your General Purpose AI model meet any of the following criteria?",
        "type": "multiple_choice",
        "options": {
            "high_impact_capabilities": {
                "label": "It has high-impact capabilities evaluated on the basis of appropriate technical tools and methodologies, including indicators and benchmarks",
                "status_changes": [
                    "GPAI with systemic risk"
                ],
                "next": "R2"
            },
            "commission_decision": {
                "label": "The European Commission has decided that the model has capabilities or impact equivalent to those described above based on the criteria set out in Annex XIII",
                "status_changes": [
                    "GPAI with systemic risk"
                ],
                "next": "R2"
            },
            "none": {
                "label": "None of the above",
                "next": "R2"
            }
        },
        "legal_basis": [
            "Article 51"
        ],
        "guidance": [
            "A General Purpose AI model is presumed to have high-impact capabilities when the cumulative amount of computation used for its training measured in floating point operations is greater than 10^25 FLOPs."
        ]
    },


{
    "E1": {
      "section": "Entity",
      "question": "Which kind of entity is your organisation?",
      "type": "single_choice",
      "options": {
        "provider": {
          "label": "Provider",
          "obligations": ["AI Literacy"],
          "next": "E2"
        },
        "deployer": {
          "label": "Deployer",
          "obligations": ["AI Literacy"],
          "next": "E2"
        },
        "distributor": {
          "label": "Distributor",
          "next": "E2"
        },
        "importer": {
          "label": "Importer",
          "next": "E2"
        },
        "product_manufacturer": {
          "label": "Product Manufacturer",
          "next": "E3"
        },
        "authorised_representative": {
          "label": "Authorised Representative",
          "obligations": ["Authorised Representative"],
          "next": "END"
        }
      },
      "legal_basis": [
        "Article 3 points 2-8",
        "Recital 87"
      ]
    },
  
    "E2": {
      "section": "Entity",
      "question": "Do you (or a downstream deployer, distributor, or importer) make any of the following modifications to the AI system?",
      "type": "multiple_choice",
      "options": {
        "different_name_or_trademark": {
        "label": "Putting a different name or trademark on the system",
        "status_changes": ["Become a Provider"],
        "next": "HR1"
        },
        "modified_intended_purpose": {
        "label": "Modifying the intended purpose of a system already in operation",
        "status_changes": ["Become a Provider"],
        "next": "HR1"
        },
        "substantial_modification": {
        "label": "Performing a substantial modification to the system",
        "status_changes": ["Become a Provider"],
        "next": "HR1"
        },
        "none": {
        "label": "None of the above",
        "next": "HR1"
        }   
      },
      "legal_basis": [
        "Article 25 points 1-2",
        "Article 3 point 23"
      ]
    },

    "E3": {
        "section": "Entity",
        "question": "Does your product integrate an AI system AND meet either of the following criteria?",
        "type": "multiple_choice",
        "options": {
            "marketed_with_product": {
                "label": "The AI system was or will be placed on the market together with my product under my manufacturer name or trademark",
                "next": "HR6"
            },
            "put_into_service_after_product": {
                "label": "The AI system was or will be put into service under my manufacturer name or trademark after my product has been placed on the market",
                "next": "HR6"
            },
            "none": {
                "label": "None of the above",
                "status_changes": [
                    "Out of scope"
                ],
                "next": "END"
            }
        },
        "legal_basis": [
            "Article 25 point 3",
            "Annex I"
        ],
        "guidance": [
            "This applies only if the product is placed on the market or put into service within the EU, regardless of whether or not the product manufacturer is established within the EU."
        ]
    },
  

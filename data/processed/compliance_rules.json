    "S1": {
        "section": "Scope",
        "question": "Do you meet any of the following criteria?",
        "type": "multiple_choice",
        "options": {
            "ai_system_eu_market": {
                "label": "I am placing on the market or putting into service AI systems in the EU",
                "applies_to": [
                    "provider"
                ]
            },
            "gpai_eu_market": {
                "label": "I am placing on the market General Purpose AI models in the EU",
                "applies_to": [
                    "provider"
                ],
                "next": "R1"
            },
            "deployer_established_eu": {
                "label": "I am established or located within the EU",
                "applies_to": [
                    "deployer"
                ]
            },
            "importer_established_eu": {
                "label": "I am established or located within the EU, and I am placing on the market an AI system that bears the name or trademark of somebody established outside of the EU",
                "applies_to": [
                    "importer"
                ]
            },
            "output_used_eu": {
                "label": "My AI system's output is used in the EU",
                "applies_to": [
                    "provider",
                    "deployer",
                    "distributor"
                ]
            },
            "none": {
                "label": "None of the above",
                "status_changes": [
                    "Out of scope"
                ],
                "next": "END"
            }
        },
        "legal_basis": [
            "Article 2"
        ]
    },

    "R1": {
        "section": "Rules",
        "question": "Does your General Purpose AI model meet any of the following criteria?",
        "type": "multiple_choice",
        "options": {
            "high_impact_capabilities": {
                "label": "It has high-impact capabilities evaluated on the basis of appropriate technical tools and methodologies, including indicators and benchmarks",
                "status_changes": [
                    "GPAI with systemic risk"
                ],
                "next": "R2"
            },
            "compute_threshold": {
                "label": "The cumulative amount of computation used for its training measured in floating point operations is greater than 10^25 FLOPs",
                "status_changes": [
                    "GPAI with systemic risk"
                ],
                "next": "R2"
            },
            "commission_decision": {
                "label": "The European Commission has decided that the model has capabilities or impact equivalent to those described above",
                "status_changes": [
                    "GPAI with systemic risk"
                ],
                "next": "R2"
            },
            "none": {
                "label": "None of the above",
                "next": "R2"
            }
        },
        "legal_basis": [
            "Article 51"
        ]
    },

    "R2": {
        "section": "Rules",
        "question": "Do any of the following exclusions apply to your AI system or model?",
        "type": "multiple_choice",
        "options": {
            "military_defence_national_security": {
                "label": "The AI system is intended to be used exclusively for military, defence or national security purposes",
                "status_changes": [
                    "Exception"
                ],
                "next": "END"
            },
            "third_country_public_authority": {
                "label": "The AI system is used by a public authority in a third country or by an international organisation under an international cooperation or law-enforcement agreement with the EU or a Member State, with adequate safeguards for fundamental rights and freedoms",
                "status_changes": [
                    "Exception"
                ],
                "next": "END"
            },
            "scientific_research_development": {
                "label": "The AI system or model is specifically developed and put into service for the sole purpose of scientific research and development",
                "status_changes": [
                    "Exception"
                ],
                "next": "END"
            },
            "research_testing_before_market": {
                "label": "The activity concerns research, testing or development regarding AI systems or models before they are placed on the market or put into service, excluding testing in real-world conditions",
                "status_changes": [
                    "Exception"
                ],
                "next": "END"
            },
            "none": {
                "label": "None of the above",
                "next": "R3"
            }
        },
        "legal_basis": [
            "Article 2"
        ]
    },

    "R3": {
        "section": "Rules",
        "question": "Does your AI system fall within any of the following prohibited AI practice categories?",

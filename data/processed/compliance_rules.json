    "HR5": {
        "section": "High Risk Status",
        "question": "Does your AI system pose a significant risk of harm to the health, safety or fundamental rights of any person?",
        "type": "single_choice",
        "options": {
            "yes": {
                "label": "Yes",
                "status_changes": [
                    "High risk"
                ],
                "next": "S1"
            },
            "no": {
                "label": "No",
                "obligations": [
                    "Notify NCA"
                ],
                "next": "S1"
            }
        },
        "legal_basis": [
            "Article 6 point 3"
        ],
        "guidance": [
            "The system does not pose a significant risk if it is intended to perform a narrow procedural task.",
            "The system does not pose a significant risk if it is intended to improve the result of a previously completed human activity.",
            "The system does not pose a significant risk if it is intended to detect decision-making patterns or deviations from prior decision-making patterns and is not meant to replace or influence the previously completed human assessment without proper human review.",
            "The system does not pose a significant risk if it is intended to perform a preparatory task to an assessment relevant for the purposes of the use cases listed in Annex III.",
            "If the system performs profiling of natural persons, select Yes."
        ]
    },

